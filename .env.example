# =============================================================================
# Marketing Agent — environment
#
#   1. npm run env:setup   -> copies this file to .env and fills every
#                             __GENERATE__ value with a strong random secret
#   2. Replace each `replace-me` with your API key
#   3. npm run env:check   -> tells you exactly which keys are still missing
#
# Everything that isn't an API key already has a working default.
# The same .env is used by Next.js and by n8n (Settings > Variables, or env_file).
# =============================================================================

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Session signing secret for Auth.js
AUTH_SECRET=__GENERATE__
# 32-byte hex key that encrypts TikTok OAuth tokens at rest (AES-256-GCM)
ENCRYPTION_KEY=__GENERATE__

# --- Auth (Google sign-in for agency staff) ----------------------------------
AUTH_GOOGLE_ID=replace-me
AUTH_GOOGLE_SECRET=replace-me

# --- NeonDB (Postgres) -------------------------------------------------------
# Pooled connection string from the Neon console (host contains "-pooler").
# Leave as replace-me to use an embedded local Postgres in .data/ while you develop.
DATABASE_URL=replace-me
# Direct (unpooled) connection string, used for migrations
DATABASE_URL_UNPOOLED=replace-me

# --- AWS S3 ------------------------------------------------------------------
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=eu-west-1
S3_BUCKET=marketing-agent-assets
# Presigned URL lifetime in seconds
S3_PRESIGN_TTL_SECONDS=900
# Max upload size per portfolio file, in megabytes
S3_MAX_UPLOAD_MB=500

# --- n8n ---------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
# n8n public API key (Settings > n8n API) — used to import and check workflows
N8N_API_KEY=replace-me
# Shared HMAC secret signing Next.js <-> n8n requests in both directions
N8N_WEBHOOK_SECRET=__GENERATE__
# How n8n reaches this app (docker-compose overrides it to host.docker.internal)
APP_INTERNAL_URL=http://localhost:3000
# n8n: hand every job to n8n. inline: run agents inside the Next.js server (no n8n needed)
DISPATCH_MODE=inline
# true = simulate every provider and TikTok (free, offline). Set false once your keys are in.
MOCK_PROVIDERS=false

# --- Anthropic Claude (strategy, copywriting, research analysis, brand QA, vision)
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-opus-5-5
# Cheaper model for high-volume tasks (captions, hashtags, classification)
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# --- OpenAI (embeddings for brand memory + image generation) ------------------
OPENAI_API_KEY=replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Video, voice and editing ------------------------------------------------
# Runway: text/image-to-video scenes
RUNWAY_API_KEY=replace-me
# ElevenLabs: voice-overs
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Creatomate: brand templates, captions, final 9:16 render
CREATOMATE_API_KEY=replace-me

# --- Market research ---------------------------------------------------------
TAVILY_API_KEY=replace-me

# --- TikTok ------------------------------------------------------------------
# Marketing API app (business-api.tiktok.com > My Apps): Ads Manager + reporting
TIKTOK_ADS_APP_ID=replace-me
TIKTOK_ADS_APP_SECRET=replace-me
# Developer app (developers.tiktok.com): Login Kit + Content Posting API for organic posts
TIKTOK_CLIENT_KEY=replace-me
TIKTOK_CLIENT_SECRET=replace-me
TIKTOK_REDIRECT_URI=http://localhost:3000/api/tiktok/callback
# Start in sandbox; switch to false once TikTok approves your apps
TIKTOK_SANDBOX=true

# --- Email (monthly reports, approval notifications) -------------------------
RESEND_API_KEY=replace-me
EMAIL_FROM=reports@example.com

# --- Guardrails --------------------------------------------------------------
# Creatives below this brand score never reach the approval inbox (0-1)
BRAND_SCORE_THRESHOLD=0.8
# Max daily budget change the optimiser may apply without approval (percent)
MAX_DAILY_BUDGET_CHANGE_PCT=30
# Produce creatives this many days before their scheduled date
PRODUCTION_LEAD_DAYS=7

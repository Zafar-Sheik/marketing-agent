{
  "name": "Marketing Agent · agent runner",
  "nodes": [
    {
      "id": "job-received",
      "name": "Job received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "agent-runner",
        "responseMode": "onReceived",
        "responseCode": 202,
        "options": {}
      },
      "webhookId": "agent-runner"
    },
    {
      "id": "verify-signature",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst h = $json.headers;\nconst body = JSON.stringify($json.body);\nconst expected = 'sha256=' + crypto.createHmac('sha256', $vars.N8N_WEBHOOK_SECRET).update(h['x-timestamp'] + '.' + body).digest('hex');\nif (h['x-signature'] !== expected || Math.abs(Date.now() / 1000 - Number(h['x-timestamp'])) > 300) {\n  throw new Error('Invalid signature');\n}\nreturn { json: { run_id: $json.body.run_id, step: $json.body.step } };"
      }
    },
    {
      "id": "sign-request",
      "name": "Sign request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const crypto = require('crypto');\nconst body = JSON.stringify({ run_id: $json.run_id, step: $json.step });\nconst ts = Math.floor(Date.now() / 1000);\nconst sig = 'sha256=' + crypto.createHmac('sha256', $vars.N8N_WEBHOOK_SECRET).update(ts + '.' + body).digest('hex');\nreturn { json: { run_id: $json.run_id, step: $json.step, body, sig, ts: String(ts) } };"
      }
    },
    {
      "id": "run-step",
      "name": "Run step",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $vars.APP_INTERNAL_URL }}/api/internal/steps",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Signature",
              "value": "={{ $json.sig }}"
            },
            {
              "name": "X-Timestamp",
              "value": "={{ $json.ts }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 900000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "next-step",
      "name": "Next step",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sent = $('Sign request').item.json;\nreturn { json: { run_id: sent.run_id, step: $json.next, done: $json.done === true, waitSeconds: Number($json.waitSeconds || 0) } };"
      }
    },
    {
      "id": "finished-",
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "done",
              "leftValue": "={{ $json.done }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "done",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        200
      ],
      "parameters": {}
    },
    {
      "id": "needs-a-wait-",
      "name": "Needs a wait?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        420
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "wait",
              "leftValue": "={{ $json.waitSeconds }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "wait",
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1540,
        520
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": "={{ $json.waitSeconds }}",
        "unit": "seconds"
      },
      "webhookId": "agent-runner-wait"
    }
  ],
  "connections": {
    "Job received": {
      "main": [
        [
          {
            "node": "Verify signature",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify signature": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign request": {
      "main": [
        [
          {
            "node": "Run step",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run step": {
      "main": [
        [
          {
            "node": "Next step",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Next step": {
      "main": [
        [
          {
            "node": "Finished?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished?": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Needs a wait?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs a wait?": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
            "node": "Sign request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  },
  "active": false
}
